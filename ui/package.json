{
  "name": "secrets-scanner-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:stack": "node dev-stack.mjs",
    "build": "vite build",
    "check": "biome check .",
    "check:server": "cd ../server && cargo fmt --check && cargo clippy --locked --all-targets --all-features -- -D warnings",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@streamdown/code": "^2.0.0",
    "@streamdown/mermaid": "^1.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "streamdown": "2.7.1",
    "tldraw": "5.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "allowScripts": {
    "fsevents": true
  }
}
