# Local settings for the billing worker.
# Expected, Password-shaped value (low): the values of SAFE_BET, OFFICE_WIFI, and QUICK_NOTE.
# Expected, nothing: every other setting.
APP_NAME=billing-worker
APP_ENV=production
PORT=8080
CACHE_TTL_SECONDS=300
DEFAULT_LOCALE=en_US
REPORT_TEMPLATE=monthlyInvoiceSummary
SAFE_BET=myUnencryptedPWHERE
OFFICE_WIFI=Kitt3nsRule!
QUICK_NOTE="Welcome123!"
